# Anchorix v0.1 — example environment file.
# Copy to `.env` and adjust. Never commit `.env`.
# All values here are placeholders; the backend will refuse to start if
# required secrets are missing or look like example values in production.

# --- Control plane (backend) ---
ANCHORIX_ENV=development
ANCHORIX_LOG_LEVEL=info
ANCHORIX_HTTP_ADDR=0.0.0.0:8080
ANCHORIX_PUBLIC_BASE_URL=http://localhost:8080

# Session/cookie signing key (32+ random bytes, base64-encoded).
# REQUIRED. Generate with: openssl rand -base64 32
ANCHORIX_SESSION_KEY=replace-me-with-random-base64-key

# --- Database ---
POSTGRES_USER=anchorix
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=anchorix
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://anchorix:change-me-locally@postgres:5432/anchorix?sslmode=disable

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Agent enrollment (control plane settings) ---
ANCHORIX_ENROLLMENT_TOKEN_TTL=15m
ANCHORIX_AGENT_HEARTBEAT_INTERVAL=60s
ANCHORIX_AGENT_INVENTORY_INTERVAL=15m

# --- TLS (production only; dev uses plain HTTP behind a proxy) ---
# ANCHORIX_TLS_CERT_FILE=/etc/anchorix/tls/server.crt
# ANCHORIX_TLS_KEY_FILE=/etc/anchorix/tls/server.key
