{
  "name": "anchorix-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Anchorix v0.1 operator UI",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
